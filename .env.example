# Copy this file to ".env" and fill in your own values.

# Admin login (open http://localhost:5050/admin)
ADMIN_ID=tradeworld
ADMIN_PASSWORD=change-me

# WhatsApp number that receives orders: country code + number, digits only (e.g. 919876543210).
# You can also set it later in Admin → Settings.
WHATSAPP_NUMBER=

# Secret used to sign admin login tokens. Use any long random text.
JWT_SECRET=change-this-to-a-long-random-string

PORT=5050
